cc_library_headers {
    name: "libexfatprogs-headers",
    host_supported: true,
    export_include_dirs: [
        "include",
        "mkfs",
        "fsck",
        "tune",
        "label",
        "dump",
    ],
}

cc_defaults {
    name: "exfatprogs-defaults",
    host_supported: true,
    header_libs: ["libexfatprogs-headers"],
    export_header_lib_headers: ["libexfatprogs-headers"],
    cflags: ["-D_FILE_OFFSET_BITS=64"],
}
